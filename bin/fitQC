#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# fitQC -- regression quality-control for the SmartSlurm jobRecord.
#
# A standalone, on-cluster, pure bash+awk tool to (1) ASSESS the per-group
# resource fit, (2) IDENTIFY outliers, and (3) (later) REMOVE them from the
# store. It inspects exactly the data the estimator fits: one linear fit per
# (pipeline, step, refGroup) over COMPLETED rows, x = inputSize, y = memUsed
# (or timeUsed). awk does the MATH (OLS, R2, STDFIT, residuals, leverage,
# Cook's D); gnuplot (--plot, `set term dumb`) is the only thing that draws.
#
# Two views, so a store with thousands of rows and dozens of steps stays legible:
#   fitQC                 L1 triage: one line per group, worst fits first.
#   fitQC P/S/R [P/S/R..] L2 detail: fit header + ranked outlier candidates.
# Group keys are pipeline/step/refGroup (slash-joined; copy them from L1).
#
# This supersedes the off-cluster bin/reviewJobRecords.py (no Python, runs on
# the cluster). Read-only in this version; --remove lands next.
# ---------------------------------------------------------------------------
set -u

self=$(basename "$0")
usage() {
    cat >&2 <<EOF
$self -- jobRecord regression QC (assess fits, rank outliers)

  $self -i                      interactive browser (checkRun-style: pick a group,
                                inspect, plot, remove; q/qq to go up/quit)
  $self                         triage: one line per group, worst first
  $self PIPE/STEP/REF ...       detail for one or more groups
  $self --pipeline P --step S --ref R   detail by explicit fields
  $self PIPE/STEP/REF --remove 1004,1009   drop those jobIDs, re-fit
  $self PIPE/STEP/REF --auto    iteratively remove worst outliers, re-fit

Options:
  --store FILE     read this jobRecord file (default: from config.txt)
  --metric mem|time   which fit to inspect (default: mem)
  --worst N        limit rows: top-N groups (triage) / top-N points (detail)
  --resid-cut X    |deleted studentized residual| above which a point is an outlier
                   (default: auto = t0.975 by df, so small groups need a bigger
                   residual to flag; pass a number to force a fixed cut)
  --r2-below X     triage: R2 floor for the low-R2 flag (default 0.80); groups
                   fitting worse than X are surfaced even with no outlier
  --min-n N        ignore groups with fewer than N points (default 3; the fit floor)
  --pipeline P     triage/detail: restrict to pipeline P (substring)
  --step S         restrict to step S (substring)
  --ref R          restrict to ref/refGroup R (substring)
  --all            triage: also show healthy groups (hidden by default)
  --plot           detail: add a gnuplot ASCII scatter + fit line
  --no-color       disable red highlighting of suspected outliers (auto-off when
                   output is piped/redirected)
  --remove IDS     remove these comma-separated jobIDs from the one named group
  --auto           iteratively remove the worst outlier (|r|>cut), re-fit, repeat;
                   stops at --max-remove, at n<=--min-n, or when the worst point is
                   high-leverage (never auto-removed -- use --remove for those)
  --remove-worst   alias for --auto
  --max-remove N   cap for --auto (default 5)
  --dry-run        preview --remove/--auto on a scratch copy; write nothing
  -h, --help       this help

Removal always backs the store up first (jobRecord.back.<ts>.txt) and is scoped to
the named group, so a jobID colliding in another group is never touched.
EOF
    exit "${1:-0}"
}

# --- schema SSOT (jrEmitV2, JR_AWK_COLMAP, jrRefClass, JR_REF_CLASS) --------
_bindir=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=/dev/null
. "$_bindir/jobRecordSchema.sh" 2>/dev/null || { echo "$self: cannot source jobRecordSchema.sh" >&2; exit 1; }

# --- args ------------------------------------------------------------------
store=""; metric="mem"; worst=0; residCut=auto; r2below=""; minN=3
fPipe=""; fStep=""; fRef=""; showAll=0; doPlot=0
removeIDs=""; autoRemove=0; maxRemove=5; dryRun=0; useColor=auto; interactive=0
groups=()
while [ $# -gt 0 ]; do
    case "$1" in
        --store)     store=$2; shift 2;;
        --metric)    metric=$2; shift 2;;
        --worst)     worst=$2; shift 2;;
        --resid-cut) residCut=$2; shift 2;;
        --r2-below)  r2below=$2; shift 2;;
        --min-n)     minN=$2; shift 2;;
        --pipeline)  fPipe=$2; shift 2;;
        --step|--program) fStep=$2; shift 2;;
        --ref)       fRef=$2; shift 2;;
        --all)       showAll=1; shift;;
        --plot)      doPlot=1; shift;;
        --no-color)  useColor=off; shift;;
        -i|--interactive) interactive=1; shift;;
        --remove)    removeIDs=$2; shift 2;;
        --auto|--remove-worst) autoRemove=1; shift;;
        --max-remove) maxRemove=$2; shift 2;;
        --dry-run)   dryRun=1; shift;;
        -h|--help)   usage 0;;
        --)          shift; while [ $# -gt 0 ]; do groups+=("$1"); shift; done;;
        -*)          echo "$self: unknown option: $1" >&2; usage 1;;
        *)           groups+=("$1"); shift;;
    esac
done
case "$metric" in mem|time) ;; *) echo "$self: --metric must be mem or time" >&2; exit 1;; esac

# Color: auto = on only when stdout is a terminal (so pipes/redirects/the harness
# get plain text); --no-color forces off. Suspected outliers (over the cut) show red.
[ "$useColor" = auto ] && { [ -t 1 ] && useColor=on || useColor=off; }
if [ "$useColor" = on ]; then C_RED=$'\033[31m'; C_OFF=$'\033[0m'; else C_RED=; C_OFF=; fi

# --- locate the store ------------------------------------------------------
if [ -z "$store" ]; then
    if [ -f ~/.smartSlurm/config/config.txt ]; then
        # shellcheck source=/dev/null
        . ~/.smartSlurm/config/config.txt 2>/dev/null
    elif [ -f "$_bindir/../config/config.txt" ]; then
        # shellcheck source=/dev/null
        . "$_bindir/../config/config.txt" 2>/dev/null
    fi
    store="${smartSlurmJobRecordDir:-}/jobRecord.txt"
fi
[ -s "$store" ] || { echo "$self: jobRecord not found or empty: $store" >&2; exit 1; }
if [ "$(jrSchemaVersion "$store")" != 2 ]; then
    echo "$self: $store is not the v2 schema. Convert it first with jrRepair.sh." >&2
    exit 1
fi

# Normalize any PIPE/STEP/REF group selectors: map the ref component through
# jrRefClass so a user can type the raw ref (hg38) or the pooled group (mammal).
wantKeys=""
for g in "${groups[@]:-}"; do
    [ -z "$g" ] && continue
    p=${g%%/*}; rest=${g#*/}; s=${rest%%/*}; r=${rest#*/}
    [ "$r" = "$rest" ] && r=""        # only two components given -> no ref
    rg=$(jrRefClass "$r")
    wantKeys="$wantKeys $p/$s/$rg"
done
wantKeys="${wantKeys# }"

metricCol=memUsed; [ "$metric" = time ] && metricCol=timeUsed

# --- the engine: one awk pass builds per-group points, then fits + diagnoses.
# Mirrors jrRefClass() for the refGroup (from JR_REF_CLASS) so grouping matches
# the estimator exactly. Statistics: OLS y=a*x+b, R2, STDFIT=sqrt(SSE/(n-2)),
# leverage h=1/n+(x-xbar)^2/Sxx, studentized residual e/(s*sqrt(1-h)),
# Cook's D = (e^2/(p*s^2))*(h/(1-h)^2) with p=2.
# engine MODE WANTKEYS : MODE is triage|detail|emit; emit prints machine-readable
# per-point diagnostics (one math implementation shared with the --remove loop).
engine() {
  jrEmitV2 "$store" | awk -F, \
    -v mcol="$metricCol" -v refmap="$JR_REF_CLASS" \
    -v mode="$1" \
    -v want="$2" -v rc="$residCut" -v worst="$worst" -v r2below="$r2below" \
    -v minN="$minN" -v fp="$fPipe" -v fs="$fStep" -v fr="$fRef" -v showAll="$showAll" \
    -v red="$C_RED" -v off="$C_OFF" \
    "$JR_AWK_COLMAP"'
    function refClass(r,   i,a,kv){
        if(r=="none"||r=="") return (r=="")?"":"none"
        for(i in RM) if(i==r) return RM[i]
        return r
    }
    BEGIN{
        n=split(refmap,A," "); for(i=1;i<=n;i++){ split(A[i],kv,"="); RM[kv[1]]=kv[2] }
        nw=split(want,W," "); for(i=1;i<=nw;i++) WANT[W[i]]=1
        p=2  # fit parameters (slope, intercept)
        # two-sided 95% t critical value by df (1..30); used as the per-group outlier
        # cut when rc=="auto", so a small group needs a bigger deleted residual to
        # flag (df = n-p-1). df<1 or >30 -> 2.0.
        ntt=split("12.71 4.30 3.18 2.78 2.57 2.45 2.36 2.31 2.26 2.23 2.20 2.18 2.16 2.14 2.13 2.12 2.11 2.10 2.09 2.09 2.08 2.07 2.07 2.06 2.06 2.06 2.05 2.05 2.05 2.04",TT," ")
    }
    function tcrit(df){ return (df<1||df>30)?2.0:TT[df]+0 }
    # the outlier cut for a group of G_n points: df-calibrated t when auto, else fixed.
    function groupcut(){ return (rc=="auto")? tcrit(G_n-3) : rc+0 }
    $(col["status"])=="COMPLETED" && $(col["inputSize"])+0>0 {
        pipe=$(col["pipeline"]); step=$(col["step"]); rg=refClass($(col["ref"]))
        key=pipe"/"step"/"rg
        if(fp!="" && index(pipe,fp)==0) next
        if(fs!="" && index(step,fs)==0) next
        if(fr!="" && index(rg,fr)==0 && index($(col["ref"]),fr)==0) next
        i=++cnt[key]
        X[key,i]=$(col["inputSize"])+0; Y[key,i]=$(col[mcol])+0
        JOB[key,i]=$(col["jobID"]); CORE[key,i]=$(col["cores"])
        if(!(key in seen)){ seen[key]=1; KEYS[++nk]=key }
        # Distinct rAP step NUMBERS feeding this group (leading field of the flag,
        # e.g. "2.1.bowtie2.s1" -> 2). >1 means two pipeline steps share this
        # step name + ref and are regressed together -- a non-blocking warning.
        sn=$(col["flag"]); sub(/\..*/,"",sn)
        if(sn ~ /^[0-9]+$/ && !((key SUBSEP sn) in snseen)){
            snseen[key SUBSEP sn]=1
            snlist[key]=(snlist[key]=="")?sn:snlist[key]","sn
            snc[key]++
        }
    }
    function fitgroup(key,   i,nn,sx,sy,sxx,sxy,xbar,ybar,Sxx,Syy){
        nn=cnt[key]; sx=sy=sxx=sxy=0
        for(i=1;i<=nn;i++){ sx+=X[key,i]; sy+=Y[key,i]; sxx+=X[key,i]*X[key,i]; sxy+=X[key,i]*Y[key,i] }
        xbar=sx/nn; ybar=sy/nn
        Sxx=sxx-sx*xbar
        if(Sxx<=0){ A_=0; B_=ybar } else { A_=(sxy-sx*ybar)/Sxx; B_=ybar-A_*xbar }
        SSE=Syy=0
        for(i=1;i<=nn;i++){ e=Y[key,i]-(A_*X[key,i]+B_); SSE+=e*e; Syy+=(Y[key,i]-ybar)*(Y[key,i]-ybar) }
        R2=(Syy>0)?1-SSE/Syy:1
        S2=(nn>2)?SSE/(nn-2):0; S=(S2>0)?sqrt(S2):0
        G_n=nn; G_xbar=xbar; G_Sxx=Sxx; G_a=A_; G_b=B_; G_r2=R2; G_s=S; G_SSE=SSE
    }
    # per-point diagnostics for the last-fitted group; fills arrays by index i.
    # D_stud is the EXTERNALLY-studentized (deleted) residual: s is re-estimated
    # WITHOUT point i, so a true outlier is unbounded (the internally-studentized
    # residual is capped near sqrt(n-p) and cannot cross the cut for small groups).
    #   s_(i)^2 = (SSE - e^2/(1-h)) / (n-p-1),  p=2;  t = e / (s_(i)*sqrt(1-h)).
    # Cook D keeps the standard full-model s. Leverage h is unchanged.
    function diag(key,i,   h,e,dfe,si2){
        e=Y[key,i]-(G_a*X[key,i]+G_b)
        h=(G_Sxx>0)?(1.0/G_n+(X[key,i]-G_xbar)*(X[key,i]-G_xbar)/G_Sxx):(1.0/G_n)
        D_resid=e; D_lev=h
        dfe=G_n-3                                  # n - p - 1 (p=2)
        if(h>=1){ D_stud=0 }
        else if(dfe<1){ D_stud=(G_s>0)? e/(G_s*sqrt(1-h)) : 0 }   # n<=3: deleted s undefined -> internal
        else {
            si2=(G_SSE - e*e/(1-h))/dfe
            if(si2<=0){ D_stud=(e==0?0:(e<0?-99:99)) }            # rest collinear -> definite outlier
            else       { D_stud=e/(sqrt(si2)*sqrt(1-h)) }
        }
        D_cook=(G_s>0 && h<1)? (e*e/(2*G_s*G_s))*(h/((1-h)*(1-h))) : 0
    }
    function abss(v){ return v<0?-v:v }
    # sort a comma list of step numbers ascending, for stable display
    function sortednums(csv,   a,n,i,j,t,out){
        n=split(csv,a,","); for(i=1;i<=n;i++)for(j=i+1;j<=n;j++) if(a[j]+0<a[i]+0){t=a[i];a[i]=a[j];a[j]=t}
        out=a[1]; for(i=2;i<=n;i++) out=out","a[i]; return out
    }
    END{
        if(nk==0){ print "No COMPLETED rows match." > "/dev/stderr"; exit 0 }
        if(mode=="triage"){
            # build a sortable summary line per group
            m=0
            for(k=1;k<=nk;k++){
                key=KEYS[k]; fitgroup(key)
                nout=0; worstr=0; gc=groupcut()
                for(i=1;i<=G_n;i++){ diag(key,i); if(abss(D_stud)>gc) nout++; if(abss(D_stud)>worstr) worstr=abss(D_stud) }
                merged=(snc[key]>=2)
                # Poor-fit surfacing: a fittable group whose R2 is below the floor is
                # shown by default even if no point crosses the residual cut -- masking
                # can park a lone gross outlier right at the cut (see --auto), so the
                # fit quality, not just the cut, decides visibility. Floor defaults to
                # 0.80; --r2-below overrides it.
                floor=(r2below!=""? r2below+0 : 0.80)
                lowr2=(G_n>=minN && G_r2 < floor)
                note=""
                if(G_n<minN) note="thin(n<"minN")"
                if(lowr2) note=(note==""?"":note" ")"low-R2"
                if(merged) note=(note==""?"":note" ")"steps:"sortednums(snlist[key])
                if(note=="") note="-"
                show=(nout>0 || merged || lowr2 || G_n<minN)
                if(!showAll && !show) continue
                m++
                SKEY[m]=key; Sn[m]=G_n; Sr2[m]=G_r2; Sstd[m]=G_s; Sout[m]=nout; Sworst[m]=worstr; Snote[m]=note
                Skeyrank[m]=(G_n<minN? -1 : nout)   # thin sinks to bottom via -1
            }
            if(m==0){ print "All groups look healthy (no outliers, low-R2 fits, merged steps, or thin groups; use --all to list them)."; exit 0 }
            # sort worst-first: by #outliers desc, then worst|r| desc
            for(a=1;a<=m;a++)for(b=a+1;b<=m;b++){
                if(Skeyrank[b]>Skeyrank[a] || (Skeyrank[b]==Skeyrank[a] && Sworst[b]>Sworst[a])) {
                    for(f in SWAP) delete SWAP[f]
                    t=SKEY[a];SKEY[a]=SKEY[b];SKEY[b]=t; t=Sn[a];Sn[a]=Sn[b];Sn[b]=t
                    t=Sr2[a];Sr2[a]=Sr2[b];Sr2[b]=t; t=Sstd[a];Sstd[a]=Sstd[b];Sstd[b]=t
                    t=Sout[a];Sout[a]=Sout[b];Sout[b]=t; t=Sworst[a];Sworst[a]=Sworst[b];Sworst[b]=t
                    t=Snote[a];Snote[a]=Snote[b];Snote[b]=t; t=Skeyrank[a];Skeyrank[a]=Skeyrank[b];Skeyrank[b]=t
                }
            }
            printf "%-34s %4s %7s %9s %5s %7s  %s\n","GROUP (pipeline/step/refGroup)","n","R2","STDFIT","#out","worst|r|","note"
            lim=(worst+0>0)?worst+0:m
            for(a=1;a<=m && a<=lim;a++)
                printf "%s%-34s %4d %7.3f %9.1f %5d %7.2f  %s%s\n",(Sout[a]>0?red:""),SKEY[a],Sn[a],Sr2[a],Sstd[a],Sout[a],Sworst[a],Snote[a],(Sout[a]>0?off:"")
            print ""
            print "metric="mcol"  outlier cut "(rc=="auto"?"t.975 by df (deleted residual)":"|r|>"rc"")"  low-R2 floor "(r2below!=""?r2below+0:0.80)"  (detail: fitQC pipeline/step/refGroup)"
        } else if(mode=="emit"){
            # machine-readable per-point diagnostics for the wanted group(s):
            # key jobID x y resid studr leverage cookD n r2 stdfit (tab-separated)
            for(k=1;k<=nk;k++){
                key=KEYS[k]
                if(nw>0 && !(key in WANT)) continue
                fitgroup(key); gc=groupcut()
                for(i=1;i<=G_n;i++){ diag(key,i)
                    printf "%s\t%s\t%d\t%d\t%.4f\t%.4f\t%.4f\t%.4f\t%d\t%.6f\t%.4f\t%.4f\n",\
                        key,JOB[key,i],X[key,i],Y[key,i],D_resid,D_stud,D_lev,D_cook,G_n,G_r2,G_s,gc
                }
            }
        } else {
            # detail mode: for each wanted group, header + ranked candidates
            for(k=1;k<=nk;k++){
                key=KEYS[k]
                if(nw>0 && !(key in WANT)) continue
                fitgroup(key); gc=groupcut()
                printf "== %s ==\n",key
                printf "   fit: %s = %.4g * inputSize + %.4g     n=%d  R2=%.4f  STDFIT=%.1f  (outlier cut |r|>%.2f)\n",mcol,G_a,G_b,G_n,G_r2,G_s,gc
                if(snc[key]>=2) printf "   WARNING: this group regresses %d rAP steps together (steps %s) -- same step name + ref.\n            If they are different workloads, give them distinct step names so they fit separately; otherwise ignore.\n",snc[key],sortednums(snlist[key])
                if(G_n<minN){ printf "   too thin to fit (n=%d < %d); points:\n",G_n,minN }
                hi=4.0/G_n
                # rank points by |studentized residual| desc
                for(i=1;i<=G_n;i++){ diag(key,i); DI[i]=i; DS[i]=abss(D_stud); DR[i]=D_resid; DST[i]=D_stud; DL[i]=D_lev; DC[i]=D_cook }
                for(a=1;a<=G_n;a++)for(b=a+1;b<=G_n;b++) if(DS[DI[b]]>DS[DI[a]]){ t=DI[a];DI[a]=DI[b];DI[b]=t }
                printf "   %-14s %12s %12s %9s %7s %7s %8s  %s\n","jobID","inputSize",mcol,"resid","stud-r","leverage","cookD","flags"
                lim=(worst+0>0)?worst+0:10
                shown=0; hilev=0
                for(a=1;a<=G_n;a++){
                    idx=DI[a]
                    isout=(abss(DST[idx])>gc); islev=(DL[idx]>hi); isinf=(DC[idx]>hi)
                    if(islev) hilev++
                    if(!isout && !islev && !isinf && shown>=lim) continue
                    if(shown>=lim && isout==0) continue
                    fl=""; if(isout)fl=fl"O"; if(islev)fl=fl"L"; if(isinf)fl=fl"I"; if(fl=="")fl="-"
                    printf "%s   %-14s %12d %12d %9.1f %7.2f %7.3f %8.3f  %s%s\n",(isout?red:""),JOB[key,idx],X[key,idx],Y[key,idx],DR[idx],DST[idx],DL[idx],DC[idx],fl,(isout?off:"")
                    shown++
                }
                clean=G_n-shown; if(clean>0) printf "   (%d clean point%s not shown)\n",clean,(clean==1?"":"s")
                if(hilev>0) printf "   note: %d high-leverage point%s (L) -- often your most valuable extremes; never auto-remove.\n",hilev,(hilev==1?"":"s")
                print "   flags: O=outlier(|r|>"gc", deleted t)  L=high-leverage(h>4/n)  I=influential(cookD>4/n)"
                print ""
            }
        }
    }'
}   # end engine()

# --- mutation helpers (Phase 2) --------------------------------------------
# Removal is backed up (reusing cleanUp's jobRecord.back.<ts>.txt naming) and
# scoped to the named group: a jobID is dropped only from rows whose
# (pipeline, step, refGroup) matches, so a colliding id elsewhere is never hit.
backupPath=""
_backup_once() {
    [ -n "$backupPath" ] && return 0
    local dir ts
    dir=$(dirname "$store"); ts=$(date +%Y-%m-%d_%H-%M-%S)
    backupPath="$dir/jobRecord.back.$ts.txt"
    cp "$store" "$backupPath" && echo "Backed up store -> $backupPath (roll back by restoring this file)."
}
_prune() {   # $1=groupKey  $2=comma-separated jobIDs -> rewrite store without them
    local key=$1 ids=$2 p rest s rg tmp
    p=${key%%/*}; rest=${key#*/}; s=${rest%%/*}; rg=${rest#*/}
    tmp=$(mktemp)
    # store is v2 (verified); rewrite the raw file name-addressed, header kept.
    awk -F, -v OFS=, -v p="$p" -v s="$s" -v rg="$rg" -v ids="$ids" -v refmap="$JR_REF_CLASS" '
        BEGIN{ n=split(ids,a,","); for(i=1;i<=n;i++) R[a[i]]=1
               m=split(refmap,M," "); for(i=1;i<=m;i++){ split(M[i],kv,"="); RM[kv[1]]=kv[2] } }
        function refClass(r,  i){ if(r=="none"||r=="")return (r=="")?"":"none"; for(i in RM) if(i==r)return RM[i]; return r }
        NR==1{ for(i=1;i<=NF;i++) col[$i]=i; print; next }
        { k=$(col["pipeline"])"/"$(col["step"])"/"refClass($(col["ref"]))
          if(k==(p"/"s"/"rg) && ($(col["jobID"]) in R)) next
          print }' "$store" > "$tmp" && mv "$tmp" "$store"
}

# _auto_remove GROUP : iteratively prune the worst over-cut outlier, re-fit, repeat.
# Stops at --max-remove, at n<=min-n, or when the worst point is high-leverage
# (never auto-removed). Caller takes the backup first. Prints the removal trail.
_auto_remove() {
    local grp=$1 pass pick jid br islev nn trail=""
    for (( pass=1; pass<=maxRemove; pass++ )); do
        # per-group cut is emit field 12 (df-calibrated when auto) -> same threshold
        # as triage/detail, no recompute.
        pick=$(engine emit "$grp" | awk '
            BEGIN{best=-1}
            { ar=($6<0?-$6:$6); n=$9; hi=4.0/n; cut=$12
              if(ar>cut && ar>best){best=ar; jid=$2; islev=($7>hi); nn=n} }
            END{ if(best<0) print "NONE"; else printf "%s %.2f %d %d\n",jid,best,islev,nn }')
        # shellcheck disable=SC2086
        set -- $pick
        if [ "$1" = NONE ]; then echo ">>> converged: no point over the outlier cut"; break; fi
        jid=$1; br=$2; islev=$3; nn=$4
        if [ "$nn" -le "$minN" ]; then echo ">>> stop: group at n=$nn (min-n=$minN); refusing to thin further"; break; fi
        if [ "$islev" = 1 ]; then
            echo ">>> stop: worst candidate jobID $jid (|r|=$br) is HIGH-LEVERAGE -- often a valuable extreme."
            echo "         not auto-removing; inspect it, and if it is truly bad remove it explicitly: fitQC $grp --remove $jid"
            break
        fi
        _prune "$grp" "$jid"
        trail="$trail $jid(|r|=$br)"
        echo "    pass $pass: removed jobID $jid (|stud-r|=$br)"
    done
    [ -n "$trail" ] && echo ">>> removed:$trail"
}

# --- dispatch --------------------------------------------------------------
if [ -n "$removeIDs" ] || [ "$autoRemove" = 1 ]; then
    # mutation needs exactly one resolved group
    # shellcheck disable=SC2086
    set -- $wantKeys
    [ "$#" -eq 1 ] || { echo "$self: --remove/--auto need exactly one group as PIPE/STEP/REF (got: ${wantKeys:-none})" >&2; exit 1; }
    grp=$1
    if [ "$dryRun" = 1 ]; then
        work=$(mktemp); cp "$store" "$work"; store="$work"
        echo "(dry run: operating on a scratch copy; the real store is untouched)"
    fi

    echo "### BEFORE ###"; engine detail "$grp"

    if [ -n "$removeIDs" ]; then
        [ "$dryRun" = 1 ] || _backup_once
        _prune "$grp" "$removeIDs"
        echo ">>> removed [$removeIDs] from $grp"
    fi

    if [ "$autoRemove" = 1 ]; then
        [ "$dryRun" = 1 ] || _backup_once
        _auto_remove "$grp"
    fi

    echo "### AFTER ###"; engine detail "$grp"
    if [ "$dryRun" = 1 ]; then rm -f "$store"; echo "(dry run: nothing was written)"; fi
    exit 0
fi

# plot_group KEY : a compact gnuplot ASCII scatter + fit line for one group -- the
# "plot on top" pane. Display-only (no labels/selection); the ranked table below
# does the precise work. gnuplot does the drawing (never hand-rolled in awk).
plot_group() {
    local key=$1 clean out all term spec npts
    clean=$(mktemp); out=$(mktemp); all=$(mktemp)
    # split this group's points into clean vs over-cut (outlier), reusing the
    # engine's per-point verdict (emit field 6=stud-r, 12=cut) so the plot agrees
    # with the table. Columns emitted: inputSize mem.
    engine emit "$key" | awk -v c="$clean" -v o="$out" -v a="$all" \
        '{ ar=($6<0?-$6:$6); print $3,$4 > a; if(ar>$12) print $3,$4 > o; else print $3,$4 > c }'
    npts=$(wc -l < "$all")
    if [ "${npts:-0}" -lt 1 ]; then rm -f "$clean" "$out" "$all"; return; fi
    if [ "$useColor" = on ]; then term="dumb ansi256"; else term="dumb"; fi
    printf '   plot: %s vs inputSize   (%sred%s = suspected outlier)\n' "$metricCol" "$C_RED" "$C_OFF"
    # fit line on ALL points (matches the table's fit); only include series with data.
    spec=""
    [ "$npts" -ge 2 ] && spec="f(x) w lines lc rgb 'yellow'"
    [ -s "$clean" ] && spec="${spec:+$spec, }'$clean' u 1:2 w points lc rgb 'cyan' pt '+'"
    [ -s "$out" ]   && spec="${spec:+$spec, }'$out' u 1:2 w points lc rgb 'red' pt 'O'"
    # small margins so points at the data extremes sit inside the frame, not on it.
    gnuplot -e "set term $term size 74,16; set key off; set offsets graph 0.02,0.02,0.06,0.06; set fit logfile '/dev/null'; set fit quiet; f(x)=a*x+b; fit f(x) '$all' u 1:2 via a,b; plot $spec" 2>/dev/null
    rm -f "$clean" "$out" "$all"
}

# --- interactive browser (checkRun-style; prompt-driven, up/down levels) -------
_clear() { clear 2>/dev/null || printf '\033[H\033[2J'; }
_pause() { printf '   %b[Enter] back%b ' "$C_RED" "$C_OFF"; read -r _ </dev/tty; }
QUIT=0

# fitq_group GROUP : level-2 inspect view. Returns 0 if the store was mutated
# (so the group list refreshes its counts), else 1. Redraws only on entry and
# after a change -- the plot submenu and bad input reuse the cached detail.
fitq_group() {
    local grp=$1 detail tok mutated=0 redraw=1
    while [ "$QUIT" = 0 ]; do
        [ "$redraw" = 1 ] && { detail=$(engine detail "$grp"); redraw=0; }
        _clear
        printf '%s\n\n' "$detail"
        echo "p = plot   ·   r <ids> = remove   ·   A = auto-remove   ·   b = back   ·   q/qq = quit"
        read -rp "> " tok </dev/tty || break
        # shellcheck disable=SC2086
        set -- $tok
        case "${1:-}" in
            ''|b) break;;
            q)    break;;
            qq)   QUIT=1; break;;
            p)    _clear; plot_group "$grp"; _pause;;                     # plot submenu -> back up
            r)    shift; if [ -n "$*" ]; then _backup_once; _prune "$grp" "$(echo "$* "|tr ' ' ',')"; mutated=1; redraw=1; fi;;
            A)    _backup_once; _auto_remove "$grp"; _pause; mutated=1; redraw=1;;
            *)    ;;                                                       # ignore junk (no recompute)
        esac
    done
    [ "$mutated" = 1 ]
}

# fitq_interactive : level-1 group list. Caches the triage + key list; recomputes
# only on entry, refresh, all/actionable toggle, or after a mutation.
fitq_interactive() {
    local tok triage dirty=1
    local -a keys
    while [ "$QUIT" = 0 ]; do
        if [ "$dirty" = 1 ]; then
            triage=$(engine triage "")
            # strip ANSI before parsing keys: a red (outlier) row would otherwise
            # carry an escape prefix on $1 and never match on the detail lookup.
            mapfile -t keys < <(printf '%s\n' "$triage" | sed 's/\x1b\[[0-9;]*m//g' | awk '$1 ~ /\//{print $1}')
            dirty=0
        fi
        _clear
        printf 'fitQC  —  %s\n\n' "$store"
        # number the group rows and give the index its own "#" header, aligned to
        # the "%3d) " row prefix (both 5 cols) so every column lines up. The footer
        # legend is moved below the list; the all-healthy message still prints.
        printf '%s\n' "$triage" | awk '
            /^GROUP/   { printf "  #  %s\n", $0; next }
            $1 ~ /\//  { printf "%3d) %s\n", ++i, $0; next }
            /^metric=/ { foot=$0; next }
            NF         { print }
            END        { if(foot!="") printf "\n     %s\n", foot }'
        echo
        echo "<#> inspect group   ·   a = all/actionable   ·   r = refresh   ·   q = quit"
        read -rp "> " tok </dev/tty || break
        case "$tok" in
            q|qq) break;;
            ''|r) dirty=1;;
            a)    showAll=$([ "$showAll" = 1 ] && echo 0 || echo 1); dirty=1;;
            *[!0-9]*) ;;
            *)    if [ "$tok" -ge 1 ] 2>/dev/null && [ "$tok" -le "${#keys[@]}" ]; then
                      fitq_group "${keys[$((tok-1))]}" && dirty=1
                  fi;;
        esac
    done
    _clear
}

if [ "$interactive" = 1 ]; then
    [ -e /dev/tty ] || { echo "$self: --interactive needs a terminal" >&2; exit 1; }
    fitq_interactive
    exit 0
fi

# read-only views: triage, or detail (per group; with --plot the plot sits on top)
if [ ${#groups[@]} -gt 0 ]; then
    if [ "$doPlot" = 1 ]; then
        for key in $wantKeys; do plot_group "$key"; engine detail "$key"; done
    else
        engine detail "$wantKeys"
    fi
else
    engine triage ""
fi
